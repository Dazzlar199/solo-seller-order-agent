# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to 1 to run without keys (fake PayPal responses, same interface). Leave 0 for the real sandbox.
MOCK_PAYPAL=0

# Public URL of this app, used for PayPal return/cancel redirects
APP_BASE_URL=http://localhost:8000

# --- LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty to use the rule-based fallback parser ---
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Local alternative (LM Studio): LLM_BASE_URL=http://localhost:1234/v1  LLM_API_KEY=lm-studio  LLM_MODEL=<loaded model>

# --- Public demo limits (optional; defaults shown) ---
# CHAT_PER_IP_HOUR=30      # per-IP messages/hour; above this the LLM is skipped, at 2x chat is refused (429)
# LLM_DAILY_CAP=500        # global LLM calls per UTC day; above this everyone gets rule-based answers
# MAX_MESSAGE_CHARS=500
# Behind nginx at /order-demo/: APP_BASE_URL=https://example.com/order-demo and run uvicorn with --root-path /order-demo
